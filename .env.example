# Copy this file to .env and replace the placeholder locally.
# .env is ignored by Git and is read only by the host-side controller.
DEEPSEEK_API_KEY=replace_with_your_key
REPAIR_ASSISTANT_MODEL=deepseek-flash

# Optional: use a compatible API endpoint.
# REPAIR_ASSISTANT_BASE_URL=https://api.deepseek.com

# Optional: PEM bundle for a private or organization-managed CA.
# REPAIR_ASSISTANT_CA_BUNDLE=/absolute/path/to/ca-bundle.pem

# Optional request limits.
# REPAIR_ASSISTANT_MODEL_TIMEOUT_SECONDS=120
# REPAIR_ASSISTANT_MAX_TOKENS=8192
