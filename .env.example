# Copy this file to .env and replace the placeholder locally.
# .env is ignored by Git and is read only by the host-side controller.
DEEPSEEK_API_KEY=replace_with_your_key
REPAIR_ASSISTANT_MODEL=deepseek-chat
REPAIR_ASSISTANT_PROVIDER=deepseek

# Optional: use a compatible API endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: PEM bundle for a private or organization-managed CA.
# REPAIR_ASSISTANT_CA_BUNDLE=/absolute/path/to/ca-bundle.pem

# Local MLX alternative (no API key required):
# REPAIR_ASSISTANT_PROVIDER=mlx-local
# REPAIR_ASSISTANT_MODEL=default_model
# REPAIR_ASSISTANT_BASE_URL=http://127.0.0.1:8080/v1
# REPAIR_ASSISTANT_MODEL_TIMEOUT_SECONDS=600
# REPAIR_ASSISTANT_MAX_TOKENS=2048
