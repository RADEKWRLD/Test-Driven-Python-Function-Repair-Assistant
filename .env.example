# Copy this file to .env and replace the placeholder locally.
# .env is ignored by Git and is read only by the host-side controller.
# Choose one provider. For Alibaba Cloud Model Studio use bailian.
REPAIR_ASSISTANT_PROVIDER=bailian
DASHSCOPE_API_KEY=replace_with_your_key
REPAIR_ASSISTANT_MODEL=qwen3.8-flash

# DeepSeek remains available:
# REPAIR_ASSISTANT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace_with_your_key
# REPAIR_ASSISTANT_MODEL=deepseek-flash

# Recommended for Model Studio: use the workspace-dedicated compatible endpoint.
# BAILIAN_BASE_URL=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Legacy Beijing endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional provider-independent endpoint override.
# REPAIR_ASSISTANT_BASE_URL=https://example.com/compatible-mode/v1

# Optional: PEM bundle for a private or organization-managed CA.
# REPAIR_ASSISTANT_CA_BUNDLE=/absolute/path/to/ca-bundle.pem

# Optional request limits.
# REPAIR_ASSISTANT_MODEL_TIMEOUT_SECONDS=120
# REPAIR_ASSISTANT_MAX_TOKENS=8192
